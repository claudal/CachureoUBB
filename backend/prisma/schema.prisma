generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Puedes ajustar esto a mysql, sqlite, etc.
  url      = env("DATABASE_URL")
}

// ======================================================
// TABLAS MAESTRAS / CATÁLOGOS
// ======================================================

model Campus {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(100)
  direccion   String? @db.Text

  oficinas        Oficina[]
  alertasBusqueda AlertaBusqueda[]

  @@map("campus")
}

model EstadoObjeto {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(50)

  objetosPerdidos ObjetoPerdido[]

  @@map("estado_objeto")
}

model EstadoAlerta {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(50)

  alertasBusqueda AlertaBusqueda[]

  @@map("estado_alerta")
}

model EtiquetaObjeto {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(50)

  objetos ObjetoTieneEtiqueta[]

  @@map("etiqueta_objeto")
}

model DestinoCaducidad {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(100)

  tratamientosCaducidad TratamientoCaducidad[]

  @@map("destino_caducidad")
}

// ======================================================
// ENTIDADES PRINCIPALES Y SUS RELACIONES
// ======================================================

model Administrador {
  correo     String @id @db.VarChar(255)
  contrasena String @db.VarChar(255)

  @@map("administrador")
}

model Reclamante {
  rut              String   @id @db.VarChar(9)
  fechaIngreso     DateTime @default(now()) @map("fecha_ingreso")
  nombreReclamante String   @map("nombre_reclamante") @db.VarChar(150)

  entregas Entrega[]

  @@map("reclamante")
}

model Oficina {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(100)
  descripcion String? @db.Text
  idCampus      Int     @map("id_campus")

  // Relaciones con @relation explícito
  campus Campus @relation(fields: [idCampus], references: [id], onDelete: Restrict)

  encargados      EncargadoOficina[]
  objetosPerdidos ObjetoPerdido[]
  fotos           FotoOficina[]
  reuniones       Reunion[]

  @@map("oficina")
}

model EncargadoOficina {
  rut            String  @id @db.VarChar(9)
  nombre         String  @db.VarChar(150)
  correoContacto String  @map("correo_contacto") @db.VarChar(255)
  clave          String  @db.VarChar(255)
  habilitado     Boolean @default(true)
  reinicioClave  Boolean @default(false) @map("reinicio_clave")
  idOficina      Int     @map("id_oficina")

  // Relaciones con @relation explícito
  oficina Oficina @relation(fields: [idOficina], references: [id], onDelete: Restrict)

  marcadores            MarcadorEncargado[]
  alertasLeidas         AlertaLeida[]
  solicitudesDetalles   SolicitudDetalles[]
  reuniones             Reunion[]
  entregas              Entrega[]
  tratamientosCaducidad TratamientoCaducidad[]

  @@map("encargado_oficina")
}

model ObjetoPerdido {
  id           Int      @id @default(autoincrement())
  fechaIngreso DateTime @default(now()) @map("fecha_ingreso")
  nombre       String   @db.VarChar(150)
  descripcion  String?  @db.Text
  idEstado     Int      @map("id_estado")
  idOficina    Int      @map("id_oficina")

  // Relaciones con @relation explícito
  estado  EstadoObjeto @relation(fields: [idEstado], references: [id], onDelete: Restrict)
  oficina Oficina      @relation(fields: [idOficina], references: [id], onDelete: Restrict)

  fotos                 FotoObjeto[]
  etiquetas             ObjetoTieneEtiqueta[]
  entregas              Entrega[]
  tratamientosCaducidad TratamientoCaducidad[]

  @@map("objeto_perdido")
}

model AlertaBusqueda {
  id            String   @id @default(uuid())
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")
  fechaEdicion  DateTime @updatedAt @map("fecha_edicion")
  descripcion   String   @db.Text
  idCampus        Int      @map("id_campus")
  idEstado      Int      @map("id_estado")

  // Relaciones con @relation explícito
  campus   Campus         @relation(fields: [idCampus], references: [id], onDelete: Restrict)
  estado EstadoAlerta @relation(fields: [idEstado], references: [id], onDelete: Restrict)

  marcadores          MarcadorEncargado[]
  alertasLeidas       AlertaLeida[]
  fotos               FotoAlerta[]
  cierre              CierreAlerta?
  solicitudesDetalles SolicitudDetalles[]
  reuniones           Reunion[]

  @@map("alerta_busqueda")
}

model Foto {
  id  Int    @id @default(autoincrement())
  url String @db.VarChar(500) @unique

  objetos  FotoObjeto[]
  oficinas FotoOficina[]
  alertas  FotoAlerta[]
  entrega  Entrega?

  @@map("foto")
}

model Entrega {
  id            Int      @id @default(autoincrement())
  fechaEntrega  DateTime @default(now()) @map("fecha_entrega")
  comentarios   String?  @db.Text
  rutReclamante String   @map("rut_reclamante") @db.VarChar(12)
  rutEncargado  String   @map("rut_encargado") @db.VarChar(12)
  idObjeto      Int      @map("id_objeto")
  idFoto        Int      @map("id_foto") @unique

  // Relaciones con @relation explícito
  reclamante Reclamante       @relation(fields: [rutReclamante], references: [rut], onDelete: Restrict)
  encargado  EncargadoOficina @relation(fields: [rutEncargado], references: [rut], onDelete: Restrict)
  objeto     ObjetoPerdido    @relation(fields: [idObjeto], references: [id], onDelete: Restrict)
  foto       Foto             @relation(fields: [idFoto], references: [id], onDelete: Restrict)

  cierre CierreAlerta?

  @@map("entrega")
}

// ======================================================
// TABLAS PIVOTE / INTERACCIONES (PKs Compuestas)
// ======================================================

model FotoObjeto {
  idFoto   Int @map("id_foto")
  idObjeto Int @map("id_objeto")

  // Relaciones con @relation explícito
  foto   Foto          @relation(fields: [idFoto], references: [id], onDelete: Cascade)
  objeto ObjetoPerdido @relation(fields: [idObjeto], references: [id], onDelete: Cascade)

  @@id([idFoto, idObjeto])
  @@map("foto_objeto")
}

model FotoOficina {
  idFoto    Int @map("id_foto")
  idOficina Int @map("id_oficina")

  // Relaciones con @relation explícito
  foto    Foto    @relation(fields: [idFoto], references: [id], onDelete: Cascade)
  oficina Oficina @relation(fields: [idOficina], references: [id], onDelete: Cascade)

  @@id([idFoto, idOficina])
  @@map("foto_oficina")
}

model FotoAlerta {
  idFoto   Int @map("id_foto")
  idAlerta String @map("id_alerta")

  // Relaciones con @relation explícito
  foto   Foto           @relation(fields: [idFoto], references: [id], onDelete: Cascade)
  alerta AlertaBusqueda @relation(fields: [idAlerta], references: [id], onDelete: Cascade)

  @@id([idFoto, idAlerta])
  @@map("foto_alerta")
}

model ObjetoTieneEtiqueta {
  idObjeto   Int @map("id_objeto")
  idEtiqueta Int @map("id_etiqueta")

  // Relaciones con @relation explícito
  objeto   ObjetoPerdido  @relation(fields: [idObjeto], references: [id], onDelete: Cascade)
  etiqueta EtiquetaObjeto @relation(fields: [idEtiqueta], references: [id], onDelete: Cascade)

  @@id([idObjeto, idEtiqueta])
  @@map("objeto_tiene_etiqueta")
}

model MarcadorEncargado {
  idAlerta     String    @map("id_alerta")
  rutEncargado String @map("rut_encargado") @db.VarChar(12)

  // Relaciones con @relation explícito
  alerta    AlertaBusqueda   @relation(fields: [idAlerta], references: [id], onDelete: Cascade)
  encargado EncargadoOficina @relation(fields: [rutEncargado], references: [rut], onDelete: Cascade)

  @@id([idAlerta, rutEncargado])
  @@map("marcador_encargado")
}

model AlertaLeida {
  idAlerta     String    @map("id_alerta")
  rutEncargado String @map("rut_encargado") @db.VarChar(12)

  // Relaciones con @relation explícito
  alerta    AlertaBusqueda   @relation(fields: [idAlerta], references: [id], onDelete: Cascade)
  encargado EncargadoOficina @relation(fields: [rutEncargado], references: [rut], onDelete: Cascade)

  @@id([idAlerta, rutEncargado])
  @@map("alerta_leida")
}

model CierreAlerta {
  idAlerta  String @map("id_alerta") @unique
  idEntrega Int @map("id_entrega") @unique

  // Relaciones con @relation explícito
  alerta  AlertaBusqueda @relation(fields: [idAlerta], references: [id], onDelete: Cascade)
  entrega Entrega        @relation(fields: [idEntrega], references: [id], onDelete: Cascade)

  @@id([idAlerta, idEntrega])
  @@map("cierre_alerta")
}

model SolicitudDetalles {
  idAlerta          String      @map("id_alerta")
  rutEncargado      String   @map("rut_encargado") @db.VarChar(12)
  fechaModificacion DateTime @default(now()) @updatedAt @map("fecha_modificacion")
  indicaciones      String   @db.Text

  // Relaciones con @relation explícito
  alerta    AlertaBusqueda   @relation(fields: [idAlerta], references: [id], onDelete: Cascade)
  encargado EncargadoOficina @relation(fields: [rutEncargado], references: [rut], onDelete: Cascade)

  @@id([idAlerta, rutEncargado])
  @@map("solicitud_detalles")
}

model Reunion {
  idAlerta          String      @map("id_alerta")
  rutEncargado      String   @map("rut_encargado") @db.VarChar(12)
  fechaModificacion DateTime @default(now()) @updatedAt @map("fecha_modificacion")
  indicaciones      String   @db.Text
  idOficina         Int      @map("id_oficina")

  // Relaciones con @relation explícito
  alerta    AlertaBusqueda   @relation(fields: [idAlerta], references: [id], onDelete: Cascade)
  encargado EncargadoOficina @relation(fields: [rutEncargado], references: [rut], onDelete: Cascade)
  oficina   Oficina          @relation(fields: [idOficina], references: [id], onDelete: Cascade)

  @@id([idAlerta, rutEncargado])
  @@map("reunion")
}

model TratamientoCaducidad {
  idObjeto      Int      @map("id_objeto")
  rutEncargado  String   @map("rut_encargado") @db.VarChar(12)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")
  razon         String   @db.Text
  idDestino     Int      @map("id_destino")

  // Relaciones con @relation explícito
  objeto    ObjetoPerdido    @relation(fields: [idObjeto], references: [id], onDelete: Restrict)
  encargado EncargadoOficina @relation(fields: [rutEncargado], references: [rut], onDelete: Restrict)
  destino   DestinoCaducidad @relation(fields: [idDestino], references: [id], onDelete: Restrict)

  @@id([idObjeto, rutEncargado])
  @@map("tratamiento_caducidad")
}